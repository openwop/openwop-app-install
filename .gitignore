# deps / build output
node_modules/
**/node_modules/
dist/
lib/
# …but `lib/` is a SOURCE directory under the frontend (byok/lib, …), not build
# output — re-include it so new source files there aren't silently untracked.
!frontend/react/src/**/lib/
# …and `scripts/lib/` too. The re-include above covered `src/` only, so a shared
# helper under `frontend/react/scripts/lib/` was silently untracked: `git status`
# never mentioned it, gates importing it passed locally, and a fresh clone or CI
# would fail on a missing module. Found while four gates were being consolidated
# onto one stripper — the one file the change depended on was the one git hid.
!frontend/react/scripts/lib/
!scripts/lib/
# …and the ENUMERATION above was itself the bug, which is why it caught a second
# workspace before anyone generalised it. `backend/typescript/scripts/lib/` was
# ignored for exactly the reason the note above describes, and `git add` refusing
# the file is the ONLY reason it was noticed — the module is imported by
# `scripts/build.mjs`, so a fresh clone would have failed the production build
# while every local gate stayed green. One rule for every workspace, so the next
# `scripts/lib/` does not have to be discovered the same way. (ADR 0555 P2.)
!**/scripts/lib/
!frontend/react/src/**/lib/**
*.tsbuildinfo

# runtime / local
data/
.env
.env.local
.env.*.local
*.log

# test artifacts
coverage/
test-results/
playwright-report/
.playwright/
**/.vite/

# os
.DS_Store

# firebase deploy cache (local)
.firebase/

# white-label distributable (scripts/build-whitelabel-zip.sh)
dist-whitelabel/

# ── secrets / credentials — NEVER commit (this repo is public) ──
# Private keys, certs, key material
*.pem
*.key
# EXCEPTION: the ADR 0367 trusted-pack PUBLIC keyring is reference material the
# committed-pack test verifies against — public keys only, never private.
!deploy/trusted-keys/*.pub.pem
*.p12
*.pfx
id_rsa*
# GCP / Firebase / cloud service-account keys + ADC
*service-account*.json
*serviceaccount*.json
*-credentials.json
application_default_credentials.json
gcloud-*.json
gha-creds-*.json
# npm auth
.npmrc
# terraform state (may embed secrets)
*.tfstate
*.tfstate.*
*.tfvars
# any .env variant EXCEPT the intentionally-tracked public build config + examples
.env.*
!.env.production
!.env.production.example
!.env.example
!.env*.example

# Claude Code personal/local settings (never commit)
.claude/settings.local.json

# browser tool (tools/browser) runtime artifacts
.browser-state.json
.browser-server.log

# mermaid tool (tools/mermaid) rendered output
.mermaid-out/
/node_modules/

# ADR 0146 Phase 4a — vendored CPython-WASI runtime (synced via scripts/sync-pythonwasm.sh, never committed)
backend/typescript/vendor/*.wasm

# ADR 0366 — generated per-distribution registries (never committed)
*.distribution.ts

# ADR 0509 Phase 4b — per-developer record of whether the browser lane ran.
# Local history, not shared state; `npm run ci:e2e-report` reads it.
.openwop-ci-e2e-ledger

# Deploy topology (ADR 0523) — never ships; the white-label bundle is `git archive HEAD`.
scripts/deploy.env
e2e-artifacts/

# Deploy provenance (ADR 0518 correction) — generated by scripts/write-build-commit.mjs
# before the Cloud Run source upload, and COPYed into the image by the Dockerfile.
# Gitignored on purpose: scripts/preflight-deploy.sh refuses a dirty tree via
# `git status --porcelain`, which does not list ignored files. A tracked generated
# file would make every deploy trip its own preflight.
build-meta/commit.txt
# Same reasoning for the RFC 0146 suite stamp — generated per build from the
# installed conformance package, so tracking it would dirty the tree and trip
# the deploy preflight on every run.
build-meta/corpus-suite.txt
# ADR 0550 P4 — the certification bundle + its claims projection, produced by
# `npm run test:conformance -- --certify`. Same reasoning again, and one more:
# these are EVIDENCE OF A RUN, not source. Committing them would make a claim
# that survives the code changing underneath it — the staleness the whole phase
# exists to prevent — and would let a reviewer edit a profile list in a PR.
build-meta/certification-bundle.json
build-meta/conformance-claims.json
