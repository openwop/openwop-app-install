          "contactId"
        ],
        "properties": {
          "orgId": {
            "type": "string",
            "description": "The client org the lead belongs to."
          },
          "contactId": {
            "type": "string",
            "description": "The lead (a contact bound to that client)."
          },
          "modelId": {
            "type": "string",
            "default": "v0",
            "description": "The scoring model the dispatch pinned."
          },
          "modelVersion": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "The model version the dispatch pinned."
          }
        }
      },
      "capabilities": [
        "side-effectful"
      ],
      "dag": {
        "nodes": [
          {
            "id": "evidence",
            "typeId": "feature.crm.nodes.lead-evidence@1.0.0",
            "name": "Read lead evidence",
            "position": {
              "x": 0,
              "y": 0
            },
            "config": {},
            "inputs": {
              "orgId": "{{params.orgId}}",
              "contactId": "{{params.contactId}}",
              "modelId": "{{params.modelId}}",
              "modelVersion": "{{params.modelVersion}}"
            }
          },
          {
            "id": "assess",
            "typeId": "feature.crm.nodes.assess-lead@1.0.0",
            "name": "Assess lead",
            "position": {
