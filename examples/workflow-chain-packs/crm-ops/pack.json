    {
      "chainId": "crm-ops.qualify-lead",
      "version": "1.0.0",
      "internal": true,
      "label": "Qualify Lead",
      "description": "Assesses one client lead against the client's qualification criteria, then grades it (ADR 0954 D4). lead-evidence reads what may be cited (contact fields, the client's activities for the lead, the visitor's own widget answers); assess-lead asks the model to answer the criteria from that evidence, and the CRM surface validates the answer closed-world and records it for this run only (one repair, then a typed assessment_ungrounded failure). grade-lead then scores the lead with the answers as qualifier signals. The model never sets the grade. Started through the client-scoped qualification endpoint with the model version pinned; a param-less copy refuses (the run was not started for a client lead).",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
