{
  "name": "core.openwop.workflows.campaign-orchestration",
  "version": "1.4.0",
  "kind": "workflow-chain",
  "description": "Campaign Studio orchestration spine (ADR 0158/RFC 0118), parallel channel fan-out shape — migrated from the deprecated builtin (ADR 0472 P4). chainId keeps the original id; the 5 channel children resolve by id at runtime via core.dispatch; each child's channelResult maps back for the consistency check (ADR 1020).",
  "keywords": [
    "Campaign"
  ],
  "engines": {
    "openwop": ">=1.0.0 <3.0.0"
  },
  "chains": [
    {
      "chainId": "campaign-studio.campaign-orchestration",
      "version": "1.4.0",
      "label": "Campaign orchestration",
      "description": "Validate the brief → messaging kernel → approve → save the approved kernel → generate all five channels in parallel → consistency check → finalize.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "briefId": {
            "type": "string",
            "description": "The confirmed campaign brief to orchestrate."
          },
          "provider": {
            "type": "string",
            "description": "AI provider id for this chain's model-calling nodes (for example anthropic, openai, google). Fixed into those nodes when the workflow is created. Leave unset to keep the nodes' own default."
          },
          "model": {
            "type": "string",
            "description": "Model id for this chain's model-calling nodes. Must be offered by `provider` in the host catalog. Set it together with `provider`."
          }
        },
        "required": [
          "briefId"
        ]
      },
      "producedVariables": [
        {
          "name": "channelResult_landing_page",
          "producedBy": "channel-dispatch",
          "type": "object",
          "description": "The landing page child's result ({channel, draft} or {channel, skipped, reason}), mapped out of the child's channelResult variable (ADR 1020 D2)."
        },
        {
          "name": "channelResult_ad_variants",
          "producedBy": "channel-dispatch",
          "type": "object",
          "description": "The ad variants child's result ({channel, draft} or {channel, skipped, reason}), mapped out of the child's channelResult variable (ADR 1020 D2)."
        },
        {
          "name": "channelResult_email_sequence",
          "producedBy": "channel-dispatch",
          "type": "object",
          "description": "The email sequence child's result ({channel, draft} or {channel, skipped, reason}), mapped out of the child's channelResult variable (ADR 1020 D2)."
        },
        {
          "name": "channelResult_creative_briefs",
          "producedBy": "channel-dispatch",
          "type": "object",
          "description": "The creative briefs child's result ({channel, draft} or {channel, skipped, reason}), mapped out of the child's channelResult variable (ADR 1020 D2)."
        },
        {
          "name": "channelResult_social_posts",
          "producedBy": "channel-dispatch",
          "type": "object",
          "description": "The social posts child's result ({channel, draft} or {channel, skipped, reason}), mapped out of the child's channelResult variable (ADR 1020 D2)."
        }
      ],
      "dag": {
        "nodes": [
          {
            "id": "validate",
            "typeId": "feature.campaign-brief.nodes.validate@1.0.0",
            "inputs": {
              "briefId": "{{params.briefId}}"
            }
          },
          {
            "id": "kernel",
            "typeId": "feature.campaign-brief.nodes.generate-kernel@1.1.0",
            "config": {
              "stageKernel": true
            },
            "inputs": {
              "briefId": "{{params.briefId}}",
              "provider": "{{params.provider}}",
              "model": "{{params.model}}"
            }
          },
          {
            "id": "kernel-approve",
            "typeId": "feature.campaign-orchestration.nodes.autonomy-gate@1.1.0",
            "config": {
              "actionClass": "plan.approve",
              "prompt": "Review the messaging kernel — the foundation every channel echoes. It is saved to the brief only if you approve it.",
              "title": "Approve the messaging kernel?"
            }
          },
          {
            "id": "promote-kernel",
            "typeId": "feature.campaign-brief.nodes.promote-kernel@1.0.0",
            "name": "Save the approved kernel",
            "inputs": {
              "briefId": "{{params.briefId}}"
            }
          },
          {
            "id": "channel-supervisor",
            "typeId": "core.orchestrator.supervisor@1.0.0",
            "config": {
              "mockDispatchPlan": [
                {
                  "kind": "next-worker",
                  "nextWorkerIds": [
                    "campaign-studio.channel.landing-page",
                    "campaign-studio.channel.ad-variants",
                    "campaign-studio.channel.email-sequence",
                    "campaign-studio.channel.creative-briefs",
                    "campaign-studio.channel.social-posts"
                  ]
                },
                {
                  "kind": "terminate",
                  "reason": "channels-dispatched"
                }
              ]
            }
          },
          {
            "id": "channel-dispatch",
            "typeId": "core.dispatch@1.0.0",
            "config": {
              "workerDispatchModel": "child-run",
              "fanOutPolicy": "parallel",
              "joinPolicy": {
                "mode": "wait-all",
                "onChildFailure": "collect"
              },
              "inputMapping": {
                "briefId": "briefId",
                "provider": "provider",
                "model": "model"
              },
              "perWorkerOutputMappings": {
                "campaign-studio.channel.landing-page": {
                  "channelResult_landing_page": "channelResult"
                },
                "campaign-studio.channel.ad-variants": {
                  "channelResult_ad_variants": "channelResult"
                },
                "campaign-studio.channel.email-sequence": {
                  "channelResult_email_sequence": "channelResult"
                },
                "campaign-studio.channel.creative-briefs": {
                  "channelResult_creative_briefs": "channelResult"
                },
                "campaign-studio.channel.social-posts": {
                  "channelResult_social_posts": "channelResult"
                }
              }
            }
          },
          {
            "id": "production-plan",
            "typeId": "feature.production.nodes.plan-generate@1.0.0",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "provider": "{{params.provider}}",
              "model": "{{params.model}}"
            }
          },
          {
            "id": "consistency",
            "typeId": "feature.campaign-orchestration.nodes.consistency-check@1.1.0",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "provider": "{{params.provider}}",
              "model": "{{params.model}}"
            },
            "config": {
              "resultVariables": {
                "campaign-studio.channel.landing-page": "channelResult_landing_page",
                "campaign-studio.channel.ad-variants": "channelResult_ad_variants",
                "campaign-studio.channel.email-sequence": "channelResult_email_sequence",
                "campaign-studio.channel.creative-briefs": "channelResult_creative_briefs",
                "campaign-studio.channel.social-posts": "channelResult_social_posts"
              }
            }
          },
          {
            "id": "finalize",
            "typeId": "feature.campaign-orchestration.nodes.finalize@1.1.0",
            "inputs": {
              "briefId": "{{params.briefId}}"
            }
          }
        ],
        "edges": [
          {
            "from": "validate",
            "to": "kernel"
          },
          {
            "from": "kernel",
            "to": "kernel-approve"
          },
          {
            "from": "kernel-approve",
            "to": "promote-kernel"
          },
          {
            "from": "kernel.kernel",
            "to": "promote-kernel.kernel"
          },
          {
            "from": "kernel.briefVersion",
            "to": "promote-kernel.briefVersion"
          },
          {
            "from": "kernel.priorKernelAt",
            "to": "promote-kernel.priorKernelAt"
          },
          {
            "from": "promote-kernel",
            "to": "channel-supervisor"
          },
          {
            "from": "channel-supervisor",
            "to": "channel-dispatch"
          },
          {
            "from": "channel-dispatch",
            "to": "production-plan"
          },
          {
            "from": "production-plan",
            "to": "consistency"
          },
          {
            "from": "channel-dispatch.dispatched",
            "to": "consistency.dispatched"
          },
          {
            "from": "consistency",
            "to": "finalize"
          }
        ]
      }
    }
  ]
}
