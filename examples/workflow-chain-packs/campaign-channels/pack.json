{
  "name": "core.openwop.workflows.campaign-channels",
  "version": "1.0.0",
  "kind": "workflow-chain",
  "description": "The five campaign channel child workflows (ADR 0157) — generate→approve DAGs the orchestration fans out over — migrated from the deprecated builtins (ADR 0472 P4). chainIds keep the original ids.",
  "keywords": [
    "Campaign"
  ],
  "engines": {
    "openwop": ">=1.0.0"
  },
  "chains": [
    {
      "chainId": "campaign-studio.channel.landing-page",
      "version": "1.0.0",
      "label": "Landing page",
      "description": "Generate a campaign landing page from the brief, then approve.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "briefId": {
            "type": "string",
            "description": "The campaign brief to generate this channel from."
          }
        },
        "required": [
          "briefId"
        ]
      },
      "dag": {
        "nodes": [
          {
            "id": "generate",
            "typeId": "feature.campaign-channels.nodes.generate",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "channel": "landing_page"
            }
          },
          {
            "id": "approve",
            "typeId": "core.approvalGate",
            "config": {
              "prompt": "Review the generated landing page."
            }
          }
        ],
        "edges": [
          {
            "from": "generate",
            "to": "approve"
          }
        ]
      }
    },
    {
      "chainId": "campaign-studio.channel.ad-variants",
      "version": "1.0.0",
      "label": "Ad variants",
      "description": "Generate ad variants per platform, then approve — accept all or refine a platform set.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "briefId": {
            "type": "string",
            "description": "The campaign brief to generate this channel from."
          }
        },
        "required": [
          "briefId"
        ]
      },
      "dag": {
        "nodes": [
          {
            "id": "generate",
            "typeId": "feature.campaign-channels.nodes.generate",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "channel": "ad_variants"
            }
          },
          {
            "id": "approve",
            "typeId": "core.approvalGate",
            "config": {
              "prompt": "Review the generated ad variants — accept all or refine a platform set.",
              "itemsFrom": "platformSets"
            }
          }
        ],
        "edges": [
          {
            "from": "generate",
            "to": "approve"
          }
        ]
      }
    },
    {
      "chainId": "campaign-studio.channel.email-sequence",
      "version": "1.0.0",
      "label": "Email sequence",
      "description": "Generate a campaign email sequence, then approve — accept all or refine specific emails.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "briefId": {
            "type": "string",
            "description": "The campaign brief to generate this channel from."
          }
        },
        "required": [
          "briefId"
        ]
      },
      "dag": {
        "nodes": [
          {
            "id": "generate",
            "typeId": "feature.campaign-channels.nodes.generate",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "channel": "email_sequence"
            }
          },
          {
            "id": "approve",
            "typeId": "core.approvalGate",
            "config": {
              "prompt": "Review the generated email sequence — accept all or refine specific emails.",
              "itemsFrom": "emails"
            }
          }
        ],
        "edges": [
          {
            "from": "generate",
            "to": "approve"
          }
        ]
      }
    },
    {
      "chainId": "campaign-studio.channel.creative-briefs",
      "version": "1.0.0",
      "label": "Creative briefs",
      "description": "Generate creative briefs per format, then approve — accept all or refine a format.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "briefId": {
            "type": "string",
            "description": "The campaign brief to generate this channel from."
          }
        },
        "required": [
          "briefId"
        ]
      },
      "dag": {
        "nodes": [
          {
            "id": "generate",
            "typeId": "feature.campaign-channels.nodes.generate",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "channel": "creative_briefs"
            }
          },
          {
            "id": "approve",
            "typeId": "core.approvalGate",
            "config": {
              "prompt": "Review the generated creative briefs — accept all or refine a format.",
              "itemsFrom": "briefs"
            }
          }
        ],
        "edges": [
          {
            "from": "generate",
            "to": "approve"
          }
        ]
      }
    },
    {
      "chainId": "campaign-studio.channel.social-posts",
      "version": "1.0.0",
      "label": "Social posts",
      "description": "Generate social posts, then approve — accept all or refine specific posts.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "briefId": {
            "type": "string",
            "description": "The campaign brief to generate this channel from."
          }
        },
        "required": [
          "briefId"
        ]
      },
      "dag": {
        "nodes": [
          {
            "id": "generate",
            "typeId": "feature.campaign-channels.nodes.generate",
            "inputs": {
              "briefId": "{{params.briefId}}",
              "channel": "social_posts"
            }
          },
          {
            "id": "approve",
            "typeId": "core.approvalGate",
            "config": {
              "prompt": "Review the generated social posts — accept all or refine specific posts.",
              "itemsFrom": "posts"
            }
          }
        ],
        "edges": [
          {
            "from": "generate",
            "to": "approve"
          }
        ]
      }
    }
  ]
}
