{
  "name": "vendor.openwop-app.workflows.work-twin-templates",
  "version": "1.0.0",
  "kind": "workflow-chain",
  "description": "The Work-Twin shared template library (ADR 0032 Phase 2.0), migrated off the in-tree `host/workflowTemplates.ts` catalog (ADR 0775 P2). chainIds keep the original `tmpl.<category>.<name>` ids, so the ten Work-Twin portfolios and every historical run resolve unchanged. Deterministic graphs over the demo `mock-ai` node, `core.approvalGate` and `core.subWorkflow` (composition rides RFC 0133 `subChainRef`). Every chain is `internal` (RFC 0135): these mock-AI flows stay out of the template gallery, the `/` picker and the zero-config seed, kept as replay archives (ADR 0775 P2 reachability, decided 2026-10-10; real-AI Work-Twin chains are a separate ADR). Resolves on hosts that register the demo `local.sample.demo.mock-ai` node (not the enterprise posture).",
  "author": "openwop",
  "license": "Apache-2.0",
  "engines": {
    "openwop": ">=1.0.0 <3.0.0"
  },
  "keywords": [
