{
  "name": "core.openwop.workflows.kicktodo-replan",
  "version": "1.0.4",
  "kind": "workflow-chain",
  "description": "Participant-replan workflow (ADR 0459/0463), migrated from the deprecated builtin (ADR 0472 P4). chainId keeps the original id; the falsy reject-safe barrier rides RFC 0134. 1.0.3 declares `actions: [approve, reject]` on the approval gate (maxRequestChangesIterations 0), so an unmade decision is refused instead of recorded as a decline. 1.0.4 (WF-FAIL-2): a failed enrich stops the run (enrich-fail) instead of skipping the approval gate and applying the revision unapproved.",
  "keywords": [
    "KickTodo"
  ],
  "engines": {
    "openwop": ">=1.0.0 <3.0.0"
  },
  "chains": [
    {
      "chainId": "openwop-app.kicktodo.replan",
      "version": "1.0.4",
      "label": "Replan a participant's plan",
      "description": "Compose a plan revision → clarify (one round) → humanize → approve in chat → apply the changes.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enrollmentId": {
            "type": "string"
          },
          "ownerSubject": {
            "type": "string"
          },
          "participantIntent": {
            "type": "string"
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "compose",
            "typeId": "local.openwop-app.agent-runner@1.0.0",
            "config": {
              "offerTools": [
                "openwop:kicktodo.today",
                "openwop:kicktodo.progress"
              ]
            },
            "inputs": {
              "agentId": "vendor.openwop-app.kicktodo.agents.replan-composer",
              "task": "{{params.participantIntent}}",
              "credentialRef": "managed:openwop-free"
            }
          },
          {
            "id": "clarify",
            "typeId": "feature.kicktodo.nodes.replan-clarify@1.0.0"
          },
          {
            "id": "enrich",
            "typeId": "feature.kicktodo.nodes.enrich-plan-revision@1.0.0",
            "inputs": {
              "enrollmentId": "{{params.enrollmentId}}"
            }
          },
          {
            "id": "approve",
            "typeId": "core.chat.approvalGate@1.1.0",
            "config": {
              "title": "Apply these changes to your plan?",
              "artifactType": "kicktodo.plan-revision",
              "maxRequestChangesIterations": 0,
              "actions": [
                "approve",
                "reject"
              ]
            }
          },
          {
            "id": "reject",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "replan_rejected",
              "message": "The plan changes were declined — nothing was changed."
            }
          },
          {
            "id": "enrich-fail",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "revision_not_reviewable",
              "message": "The proposed plan change could not be prepared for your approval, so nothing was changed."
            }
          },
          {
            "id": "apply",
            "typeId": "feature.kicktodo.nodes.apply-revision-commands@1.0.0",
            "inputs": {
              "enrollmentId": "{{params.enrollmentId}}",
              "subject": "{{params.ownerSubject}}"
            }
          }
        ],
        "edges": [
          {
            "from": "compose.result",
            "to": "clarify.revision",
            "triggerRule": "all_success"
          },
          {
            "from": "clarify.result",
            "to": "enrich.revision",
            "triggerRule": "all_success"
          },
          {
            "from": "enrich.result",
            "to": "approve.artifact",
            "triggerRule": "all_success"
          },
          {
            "from": "approve",
            "to": "reject",
            "condition": {
              "type": "falsy",
              "left": "approved"
            }
          },
          {
            "from": "clarify.result",
            "to": "apply",
            "triggerRule": "none_failed"
          },
          {
            "from": "reject",
            "to": "apply",
            "triggerRule": "none_failed"
          },
          {
            "from": "enrich",
            "to": "enrich-fail",
            "triggerRule": "any_failed"
          },
          {
            "from": "enrich-fail",
            "to": "apply",
            "triggerRule": "none_failed"
          }
        ]
      }
    }
  ]
}
