{
  "name": "core.openwop.workflows.notebooks",
  "version": "1.1.0",
  "kind": "workflow-chain",
  "description": "Notebooks workflows (summarize, transform, ingest-audio, ingest-youtube), migrated from the deprecated builtins (ADR 0472 P4). chainIds keep the original ids so ignition + replay resolve unchanged; node outputRoles restored at registration.",
  "keywords": [
    "Notebooks"
  ],
  "engines": {
    "openwop": ">=1.0.0 <3.0.0"
  },
  "chains": [
    {
      "chainId": "notebooks.summarize",
      "version": "1.1.0",
      "label": "notebooks.summarize",
      "description": "Summarize one notebook source (read-source → core.ai.chatCompletion → store-summary). Host machinery: started by the notebook Sources panel's Summarize action (POST …/notebooks/:id/sources/:sid/summarize), which authorizes the caller and runs as them (ADR 1103).",
      "internal": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notebookId",
          "sourceId"
        ],
        "properties": {
          "notebookId": {
            "type": "string",
            "description": "The notebook whose source is summarized."
          },
          "sourceId": {
            "type": "string",
            "description": "The source document to summarize."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "read",
            "typeId": "feature.notebooks.nodes.read-source@1.1.0",
            "inputs": {
              "notebookId": "{{params.notebookId}}",
              "sourceId": "{{params.sourceId}}"
            }
          },
          {
            "id": "generate",
            "typeId": "core.ai.chatCompletion@1.0.0",
            "config": {
              "provider": "anthropic",
              "model": "claude-sonnet-4-6",
              "systemPrompt": "Summarize the following source for a research notebook in 3-5 sentences; plain text; no preamble."
            }
          },
          {
            "id": "store",
            "typeId": "feature.notebooks.nodes.store-summary@1.2.0",
            "inputs": {
              "notebookId": "{{params.notebookId}}",
              "sourceId": "{{params.sourceId}}"
            }
          }
        ],
        "edges": [
          {
            "from": "read.messages",
            "to": "generate.messages",
            "triggerRule": "all_success"
          },
          {
            "from": "generate.content",
            "to": "store.summary",
            "triggerRule": "all_success"
          },
          {
            "from": "read.revision",
            "to": "store.revision",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "notebooks.transform",
      "version": "1.1.0",
      "label": "notebooks.transform",
      "description": "Apply a transformation template to one notebook source and save the result as a notebook-owned Document (read-source → core.ai.chatCompletion → write-transformation). Host machinery: started by the Sources panel's Transform action or the Notebook Research Analyst's write-transformation tool, as the caller (ADR 1103).",
      "internal": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notebookId",
          "sourceId",
          "systemPrompt",
          "orgId",
          "title",
          "kind",
          "ownerSubject"
        ],
        "properties": {
          "notebookId": {
            "type": "string",
            "description": "The notebook whose source is transformed (read-source fetches its text in-run)."
          },
          "sourceId": {
            "type": "string",
            "description": "The source the transformation is applied to (read + idempotency key)."
          },
          "systemPrompt": {
            "type": "string",
            "description": "The transformation template’s system prompt (read-source prepends it)."
          },
          "orgId": {
            "type": "string",
            "description": "The org the output Document is created in."
          },
          "title": {
            "type": "string",
            "description": "The output Document title."
          },
          "kind": {
            "type": "string",
            "description": "The output Document kind (the transformation’s docKind)."
          },
          "ownerSubject": {
            "type": "object",
            "description": "The owning subject (project:<notebookId>) of the output Document."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "read",
            "typeId": "feature.notebooks.nodes.read-source@1.1.0",
            "inputs": {
              "notebookId": "{{params.notebookId}}",
              "sourceId": "{{params.sourceId}}",
              "systemPrompt": "{{params.systemPrompt}}"
            }
          },
          {
            "id": "generate",
            "typeId": "core.ai.chatCompletion@1.0.0",
            "config": {
              "provider": "anthropic",
              "model": "claude-sonnet-4-6"
            }
          },
          {
            "id": "write",
            "typeId": "feature.notebooks.nodes.write-transformation@1.2.0",
            "inputs": {
              "notebookId": "{{params.notebookId}}",
              "orgId": "{{params.orgId}}",
              "title": "{{params.title}}",
              "kind": "{{params.kind}}",
              "ownerSubject": "{{params.ownerSubject}}",
              "sourceId": "{{params.sourceId}}"
            }
          }
        ],
        "edges": [
          {
            "from": "read.messages",
            "to": "generate.messages",
            "triggerRule": "all_success"
          },
          {
            "from": "generate.content",
            "to": "write.content",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "notebooks.ingest-audio",
      "version": "1.1.0",
      "label": "notebooks.ingest-audio",
      "description": "Transcribe an uploaded audio/video file and add the transcript as a notebook source. Host machinery: started by the Sources panel's audio upload, as the caller (ADR 0085, ADR 1103).",
      "internal": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notebookId",
          "title",
          "audioBase64",
          "mimeType"
        ],
        "properties": {
          "notebookId": {
            "type": "string",
            "description": "The notebook the transcribed source is added to."
          },
          "title": {
            "type": "string",
            "description": "Title for the new source."
          },
          "sourceType": {
            "type": "string",
            "description": "Provenance label woven into the title (audio|video)."
          },
          "audioBase64": {
            "type": "string",
            "description": "Base64-encoded audio/video bytes to transcribe."
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the audio/video bytes."
          },
          "language": {
            "type": "string",
            "description": "Optional spoken-language hint (BCP-47 or name)."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "transcribe",
            "typeId": "feature.notebooks.nodes.transcribe-source@1.1.0",
            "inputs": {
              "audioBase64": "{{params.audioBase64}}",
              "mimeType": "{{params.mimeType}}",
              "language": "{{params.language}}"
            }
          },
          {
            "id": "ingest",
            "typeId": "feature.notebooks.nodes.ingest-source@1.2.0",
            "inputs": {
              "notebookId": "{{params.notebookId}}",
              "title": "{{params.title}}",
              "sourceType": "{{params.sourceType}}"
            }
          }
        ],
        "edges": [
          {
            "from": "transcribe.transcript",
            "to": "ingest.text",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "notebooks.ingest-youtube",
      "version": "1.1.0",
      "label": "notebooks.ingest-youtube",
      "description": "Fetch a YouTube video's captions (or transcribe its audio) and add the transcript as a notebook source. Host machinery: started by the Sources panel's YouTube action, as the caller (ADR 0085, ADR 1103).",
      "internal": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notebookId",
          "title",
          "url"
        ],
        "properties": {
          "notebookId": {
            "type": "string",
            "description": "The notebook the transcribed source is added to."
          },
          "title": {
            "type": "string",
            "description": "Title for the new source."
          },
          "sourceType": {
            "type": "string",
            "description": "Provenance label woven into the title (youtube)."
          },
          "url": {
            "type": "string",
            "description": "The YouTube watch/share URL to fetch captions from."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "fetch",
            "typeId": "feature.notebooks.nodes.fetch-youtube-source@1.0.0",
            "inputs": {
              "url": "{{params.url}}"
            }
          },
          {
            "id": "ingest",
            "typeId": "feature.notebooks.nodes.ingest-source@1.2.0",
            "inputs": {
              "notebookId": "{{params.notebookId}}",
              "title": "{{params.title}}",
              "sourceType": "{{params.sourceType}}"
            }
          }
        ],
        "edges": [
          {
            "from": "fetch.transcript",
            "to": "ingest.text",
            "triggerRule": "all_success"
          }
        ]
      }
    }
  ]
}
