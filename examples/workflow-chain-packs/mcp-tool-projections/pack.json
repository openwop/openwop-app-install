{
  "name": "core.openwop.workflows.mcp-tool-projections",
  "version": "1.0.1",
  "kind": "workflow-chain",
  "description": "MCP tool-projection workflows (core.openwop.mcp.expose-tool → backing node), migrated from the deprecated builtinWorkflows seam (ADR 0472 P4). chainIds keep the original *.mcp.* ids; registered chain-backed with the EXACT original metadata (the ADR 0087 mcp gates) restored, and the MCP mount enumerates them.",
  "keywords": [
    "MCP",
    "Tools"
  ],
  "engines": {
    "openwop": ">=1.0.0"
  },
  "chains": [
    {
      "chainId": "commerce.ucp.mcp.catalog-search",
      "version": "1.0.0",
      "label": "ucp-catalog-search",
      "description": "MCP tool projection ucp-catalog-search.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orgId"
        ],
        "properties": {
          "orgId": {
            "type": "string",
            "description": "The merchant org id."
          },
          "q": {
            "type": "string",
            "description": "Optional search query."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "expose",
            "typeId": "core.openwop.mcp.expose-tool",
            "config": {
              "name": "ucp-catalog-search",
              "description": "Browse a merchant’s UCP shopping catalog (name/price/availability). Inputs: { orgId, q? }.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "orgId": {
                    "type": "string"
                  },
                  "q": {
                    "type": "string"
                  }
                },
                "required": [
                  "orgId"
                ],
                "additionalProperties": false
              }
            }
          },
          {
            "id": "backing",
            "typeId": "feature.commerce.nodes.list-products",
            "inputs": {
              "orgId": "{{params.orgId}}",
              "q": "{{params.q}}"
            }
          }
        ],
        "edges": [
          {
            "from": "expose.handle",
            "to": "backing._order",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "commerce.ucp.mcp.place-order",
      "version": "1.0.0",
      "label": "ucp-place-order",
      "description": "MCP tool projection ucp-place-order.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "orgId",
          "lines"
        ],
        "properties": {
          "orgId": {
            "type": "string",
            "description": "The merchant org id."
          },
          "lines": {
            "type": "array",
            "description": "Order lines."
          },
          "contactId": {
            "type": "string",
            "description": "Optional CRM contact id."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "expose",
            "typeId": "core.openwop.mcp.expose-tool",
            "config": {
              "name": "ucp-place-order",
              "description": "Place an order against a merchant (demo-mode: creates a PENDING, unpaid order — no charge; payment is a separate step). Inputs: { orgId, lines:[{productId,quantity}], contactId? }.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "orgId": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "productId",
                        "quantity"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "contactId": {
                    "type": "string"
                  }
                },
                "required": [
                  "orgId",
                  "lines"
                ],
                "additionalProperties": false
              }
            }
          },
          {
            "id": "backing",
            "typeId": "feature.commerce.nodes.create-order",
            "inputs": {
              "orgId": "{{params.orgId}}",
              "lines": "{{params.lines}}",
              "contactId": "{{params.contactId}}"
            }
          }
        ],
        "edges": [
          {
            "from": "expose.handle",
            "to": "backing._order",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "docs.mcp.docs_search",
      "version": "1.0.1",
      "label": "docs_search",
      "description": "MCP tool projection docs_search.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
