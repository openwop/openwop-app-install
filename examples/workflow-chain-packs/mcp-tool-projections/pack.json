              "description": "Search the published product documentation. Returns ranked hits with a title, snippet, public /docs URL, and relevance score.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The search query."
                  },
                  "limit": {
                    "type": "number",
                    "description": "Max hits to return (default 8, max 20)."
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          },
          {
            "id": "backing",
            "typeId": "feature.docs.nodes.search",
            "inputs": {
              "query": "{{params.query}}",
              "limit": "{{params.limit}}"
            }
          }
        ],
        "edges": [
          {
            "from": "expose.handle",
            "to": "backing._order",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "docs.mcp.docs_get",
      "version": "1.0.1",
      "label": "docs_get",
      "description": "MCP tool projection docs_get.",
      "parameters": {
        "type": "object",
