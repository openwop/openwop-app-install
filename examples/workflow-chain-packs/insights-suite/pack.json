{
  "name": "core.openwop.workflows.insights-suite",
  "version": "1.4.0",
  "kind": "workflow-chain",
  "description": "Insights & Drafting workflows: a weekly Actual-vs-Plan variance with a human review step, a work-anniversary recognition draft that you approve before it is saved to your mailbox (never sent), and a talent readiness score for one person. Version history: README.md.",
  "keywords": [
    "Insights",
    "HR",
    "Finance"
  ],
  "engines": {
    "openwop": ">=1.0.0 <3.0.0"
  },
  "chains": [
    {
      "chainId": "openwop-app.insights.weekly-variance",
      "version": "1.3.0",
      "label": "Weekly variance (Actual vs Plan)",
      "description": "Reads your financials from BigQuery, computes Actual vs Plan for sales, margin, labor and shrink, and shows you the figures to confirm before the workspace is notified.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "description": "The BigQuery project your financials live in. Scheduled runs use the one set in Settings \u2192 AI \u2192 Insights & Drafting."
          },
          "businessUnit": {
            "type": "string",
            "description": "The business unit to analyse. It labels the result."
          },
          "sql": {
            "type": "string",
            "description": "The query that reads your financials. It must return one row per metric with metric, actual and plan columns. Edit it to match your warehouse.",
            "default": "SELECT metric, actual, plan FROM `finance.weekly_variance` WHERE period = 'current_week'"
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "query",
            "typeId": "core.bigquery.query@1.0.0",
            "name": "Query financials",
            "inputs": {
              "projectId": "{{params.projectId}}",
              "sql": "{{params.sql}}"
            }
          },
          {
            "id": "compute",
            "typeId": "feature.insights-suite.nodes.variance-compute@1.3.0",
            "name": "Compute variance",
            "inputs": {
              "businessUnit": "{{params.businessUnit}}"
            }
          },
          {
            "id": "redteam",
            "typeId": "core.approvalGate@1.0.0",
            "name": "Review variance figures",
            "config": {
              "title": "Review variance figures",
              "prompt": "Check these figures before the workspace is notified.",
              "requiredApprovals": 1,
              "optionLabels": {
                "summary": "Variance figures"
              }
            }
          },
          {
            "id": "notify",
            "typeId": "feature.notifications.nodes.notify@1.0.0",
            "name": "Notify",
            "config": {
              "audience": "tenant"
            },
            "inputs": {
              "title": "Weekly variance (Actual vs Plan)"
            }
          }
        ],
        "edges": [
          {
            "from": "query.rows",
            "to": "compute.rows",
            "triggerRule": "all_success"
          },
          {
            "from": "compute.summary",
            "to": "redteam.summary",
            "triggerRule": "all_success"
          },
          {
            "from": "redteam",
            "to": "notify",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "openwop-app.insights.anniversary-draft",
      "version": "1.3.0",
      "label": "Work-anniversary recognition draft",
      "description": "Drafts a work-anniversary recognition message in your voice, from the person's milestone and your past messages in the knowledge base. You approve the text before it is saved as a draft in your mailbox. Nothing is ever sent.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectId",
          "workdayBaseUrl",
          "recipient"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "description": "The Workday worker id of the person being recognized. Only their record is read.",
            "minLength": 1,
            "pattern": "\\S"
          },
          "milestone": {
            "type": "string",
            "description": "The milestone to recognize, for example 10 years. Leave it empty when their Workday record states it."
          },
          "workdayResource": {
            "type": "string",
            "description": "The Workday resource to read the milestone from. Defaults to service dates.",
            "default": "serviceDates"
          },
          "workdayBaseUrl": {
            "type": "string",
            "description": "Your Workday REST address, for example https://{instance}.workday.com/ccx/api/v1/{tenant}."
          },
          "exemplarQuery": {
            "type": "string",
            "description": "What to search the knowledge base for as examples of your voice.",
            "default": "work anniversary recognition message exemplars in the principal's voice"
          },
          "recipient": {
            "type": "string",
            "description": "Who the message is addressed to. The draft is saved in YOUR mailbox and is never sent."
          },
          "draftSubject": {
            "type": "string",
            "description": "The subject line of the draft.",
            "default": "Work anniversary recognition"
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "milestones",
            "typeId": "core.workday.query@1.0.0",
            "name": "Milestones",
            "config": {
              "resource": "serviceDates",
              "requireWorkerId": true
            },
            "inputs": {
              "resource": "{{params.workdayResource}}",
              "baseUrl": "{{params.workdayBaseUrl}}",
              "workerId": "{{params.subjectId}}"
            }
          },
          {
            "id": "retrieve",
            "typeId": "knowledge.retrieve@1.0.0",
            "name": "Retrieve exemplars",
            "inputs": {
              "query": "{{params.exemplarQuery}}"
            }
          },
          {
            "id": "brief",
            "typeId": "feature.insights-suite.nodes.recognition-brief@1.3.0",
            "name": "Draft brief",
            "inputs": {
              "subjectId": "{{params.subjectId}}",
              "milestone": "{{params.milestone}}"
            }
          },
          {
            "id": "generate",
            "typeId": "core.ai.chatCompletion@1.0.0",
            "name": "Draft recognition",
            "config": {
              "provider": "anthropic",
              "model": "claude-sonnet-4-6",
              "systemPrompt": "Draft a warm, specific work-anniversary recognition message in the principal\u2019s voice, grounded in the exemplars and the milestone you are given. Plain text, no salutation block."
            }
          },
          {
            "id": "check",
            "typeId": "feature.insights-suite.nodes.draft-check@1.3.0",
            "name": "Refuse an empty draft"
          },
          {
            "id": "approve",
            "typeId": "core.approvalGate@1.0.0",
            "name": "Approve draft",
            "config": {
              "title": "Approve draft",
              "prompt": "Approve this recognition draft. On approval it is saved as a DRAFT in your mailbox \u2014 nothing is sent. To change the wording, edit the draft in your mailbox afterwards.",
              "requiredApprovals": 1,
              "optionLabels": {
                "draft": "Recognition draft"
              }
            }
          },
          {
            "id": "emailDraft",
            "typeId": "core.email.draft@1.0.0",
            "name": "Email draft (never sends)",
            "inputs": {
              "to": "{{params.recipient}}",
              "subject": "{{params.draftSubject}}"
            }
          },
          {
            "id": "notify",
            "typeId": "feature.notifications.nodes.notify@1.0.0",
            "name": "Notify",
            "config": {
              "audience": "self"
            },
            "inputs": {
              "title": "Work-anniversary recognition draft"
            }
          }
        ],
        "edges": [
          {
            "from": "milestones.rows",
            "to": "brief.milestoneRows",
            "triggerRule": "all_success"
          },
          {
            "from": "retrieve.chunks",
            "to": "brief.exemplars",
            "triggerRule": "all_success"
          },
          {
            "from": "brief.prompt",
            "to": "generate.prompt",
            "triggerRule": "all_success"
          },
          {
            "from": "generate.content",
            "to": "check.draft",
            "triggerRule": "all_success"
          },
          {
            "from": "check.draft",
            "to": "approve.draft",
            "triggerRule": "all_success"
          },
          {
            "from": "check.draft",
            "to": "emailDraft.body",
            "triggerRule": "all_success"
          },
          {
            "from": "approve",
            "to": "emailDraft",
            "triggerRule": "all_success"
          },
          {
            "from": "emailDraft",
            "to": "notify",
            "triggerRule": "all_success"
          }
        ]
      }
    },
    {
      "chainId": "openwop-app.insights.talent-prep",
      "version": "1.3.0",
      "label": "Talent readiness prep",
      "description": "Reads one person's performance reviews from Workday, places them on the 9-box grid, and notifies only you.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectId",
          "workdayBaseUrl"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "description": "The Workday worker id of the person to score. Only their reviews are read.",
            "minLength": 1,
            "pattern": "\\S"
          },
          "workdayBaseUrl": {
            "type": "string",
            "description": "Your Workday REST address, for example https://{instance}.workday.com/ccx/api/v1/{tenant}."
          }
        }
      },
      "dag": {
        "nodes": [
          {
            "id": "pull",
            "typeId": "core.workday.query@1.0.0",
            "name": "Pull performance",
            "config": {
              "resource": "performanceReviews",
              "requireWorkerId": true
            },
            "inputs": {
              "baseUrl": "{{params.workdayBaseUrl}}",
              "workerId": "{{params.subjectId}}"
            }
          },
          {
            "id": "score",
            "typeId": "feature.insights-suite.nodes.talent-score@1.2.0",
            "name": "Talent score",
            "inputs": {
              "subjectId": "{{params.subjectId}}"
            }
          },
          {
            "id": "notify",
            "typeId": "feature.notifications.nodes.notify@1.0.0",
            "name": "Notify",
            "config": {
              "audience": "self"
            },
            "inputs": {
              "title": "Talent readiness prep"
            }
          }
        ],
        "edges": [
          {
            "from": "pull.rows",
            "to": "score.rows",
            "triggerRule": "all_success"
          },
          {
            "from": "score.label",
            "to": "notify.message",
            "triggerRule": "all_success"
          }
        ]
      }
    }
  ]
}
