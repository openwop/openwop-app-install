      "chainId": "openwop-app.kicktodo.lesson-batch",
      "version": "1.4.0",
      "label": "Lesson batch (Challenge Factory child)",
      "description": "Builds one checkpoint of a challenge’s lessons. Internal — dispatched by the Challenge Factory, not run on its own.",
      "internal": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "authorSubject": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "description": "The plan days this checkpoint batch builds lessons for — the parent seeds it from its batchN bag variable (an array of day payloads; anything else builds an empty batch)."
          },
          "generateMedia": {
            "type": "boolean",
            "description": "Optional. When true, each lesson also gets a generated image (ADR 0458 P2). The parent maps it from its generateMedia bag variable; absent means no media."
          },
          "evidenceClaims": {
            "type": "array",
            "description": "Optional. The structured evidence (claim ids + sources) the batch’s lessons are grounded on and validated against; seeded by the parent from its evidenceClaims bag variable. Absent means no evidence was gathered, so every lesson must cite no claim (the validator rejects an unknown claimRef)."
          },
          "provider": {
            "type": "string",
            "description": "ADR 0706 — the AI provider the parent factory run froze at ignition; seeded by the parent’s inputMapping."
          },
          "model": {
            "type": "string",
            "description": "ADR 0706 — the model id frozen with provider."
          },
          "credentialRef": {
            "type": "string",
            "description": "ADR 0706 — the Secrets Vault ref NAME forwarded to ctx.callAI (not x-openwop-sensitive: a name, never a value)."
          },
          "imageProvider": {
            "type": "string",
            "description": "XCH-LB-6 — the image provider the media leg calls; seeded by the parent’s inputMapping. Never the chat provider."
          },
          "imageModel": {
            "type": "string",
            "description": "XCH-LB-6 — the image model id, with imageProvider."
          },
          "imageCredentialRef": {
            "type": "string",
            "description": "XCH-LB-6 — the Secrets Vault ref NAME forwarded to ctx.callImageGenerator (a name, never a value)."
          }
        },
        "required": [
          "candidateId",
          "authorSubject",
          "days"
        ]
      },
