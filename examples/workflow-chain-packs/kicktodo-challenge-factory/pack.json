{
  "name": "core.openwop.workflows.kicktodo-challenge-factory",
  "version": "1.9.0",
  "kind": "workflow-chain",
  "description": "The Challenge Factory (ADR 0458) + its lesson-batch child — migrated from the deprecated builtins (ADR 0472 P4, the terminal quarantine step). chainIds keep the original ids; build-0..3 reference lesson-batch via RFC 0133 config.subChainRef (host-default binds it to the shared same-id child); truthy/falsy reject-safe barriers ride RFC 0134; produced vars (plan/evidenceSummary/evidenceClaims/planBrief/planEvidenceBrief) declared per RFC 0133 §2.2; 1.4.0 (ADR 0458 §2.2 correction) grounds the plan, the lessons and the skeptic on the STRUCTURED evidence. 1.5.4 declares `actions: [approve, reject]` on all five approval gates (they set maxRequestChangesIterations 0, so those are the only real decisions — a defer/escalate/request-changes resume is now refused instead of being recorded as a decline that fails the run) and types the lesson-batch params honestly. 1.6.0: generateMedia param + image binding. 1.7.0: gate-N shows the lessons; a failed batch stops the run. 1.9.0: search uses searchQuery (ADR 0975 D3).",
  "keywords": [
    "KickTodo"
  ],
  "engines": {
    "openwop": ">=1.0.0 <3.0.0"
  },
  "chains": [
    {
      "chainId": "openwop-app.kicktodo.challenge-factory",
      "version": "1.9.0",
      "label": "Challenge Factory",
      "description": "Research a topic → draft an outline → approve → build lesson batches (each checkpoint approved) → simulate with three personas → submit for publication.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "authorSubject": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "checkpointEvery": {
            "type": "string"
          },
          "credentialRef": {
            "type": "string",
            "description": "ADR 0706 — the Secrets Vault ref NAME (never a value) the four LLM nodes and the lesson-batch child pass to ctx.callAI. Set by the Challenge Author’s run tool from the workspace’s AI default; absent ⇒ the dispatcher’s exact/prefixed-ref ladder. Plain string, deliberately NOT x-openwop-sensitive: it carries a ref name, not a secret."
          },
          "generateMedia": {
            "type": "boolean",
            "default": false,
            "description": "KTF-LB-1 / WF-3 — when true, each lesson also gets a generated image (ADR 0458 P2), reviewed at its checkpoint gate. Seeded by the Challenge Author’s run tool only when the creator asked for images; the build-N inputMapping reads it from the run bag."
          },
          "imageProvider": {
            "type": "string",
            "description": "XCH-LB-6 — the IMAGE provider for the media leg (openai/google/replicate), never the chat provider. Absent ⇒ the host’s image default."
          },
          "imageModel": {
            "type": "string",
            "description": "XCH-LB-6 — the image model id, with imageProvider. Absent ⇒ the provider’s default."
          },
          "imageCredentialRef": {
            "type": "string",
            "description": "XCH-LB-6 — the Secrets Vault ref NAME for the image provider (a name, never a value), pre-flighted by the run tool."
          },
          "transformation": {
            "type": "string",
            "description": "ADR 0975 D3 — what the participant changes (the candidate's transformation). Disambiguates the research search query; optional (the audience is the fallback)."
          }
        },
        "required": [
          "candidateId",
          "topic",
          "audience",
          "authorSubject"
        ]
      },
      "dag": {
        "nodes": [
          {
            "id": "research-frame",
            "typeId": "feature.kicktodo.nodes.research-frame@1.1.0",
            "inputs": {
              "topic": "{{params.topic}}",
              "audience": "{{params.audience}}",
              "transformation": "{{params.transformation}}"
            }
          },
          {
            "id": "search",
            "typeId": "core.web.search@1.0.0",
            "config": {
              "suitability": "durable",
              "maxResults": 8
            },
            "inputs": {
              "suitability": "durable"
            }
          },
          {
            "id": "normalize",
            "typeId": "feature.kicktodo.nodes.source-normalize@1.0.0",
            "inputs": {}
          },
          {
            "id": "fetch",
            "typeId": "core.web.fetch@1.0.0",
            "name": "Read the sources",
            "position": {
              "x": 180,
              "y": 140
            },
            "config": {
              "maxPages": 6,
              "extractReadable": true
            }
          },
          {
            "id": "extract-claims",
            "typeId": "feature.kicktodo.nodes.claim-extract@1.0.0",
            "name": "Extract cited claims",
            "position": {
              "x": 540,
              "y": 0
            },
            "config": {},
            "inputs": {
              "provider": "{{params.provider}}",
              "model": "{{params.model}}",
              "credentialRef": "{{params.credentialRef}}"
            }
          },
          {
            "id": "verify-claims",
            "typeId": "feature.kicktodo.nodes.claim-verify@1.0.0",
            "name": "Verify each claim against its source",
            "position": {
              "x": 720,
              "y": 0
            },
            "config": {},
            "inputs": {
              "provider": "{{params.provider}}",
              "model": "{{params.model}}",
              "credentialRef": "{{params.credentialRef}}"
            }
          },
          {
            "id": "evidence-graph",
            "typeId": "feature.kicktodo.nodes.evidence-graph@1.0.0",
            "inputs": {
              "candidateId": "{{params.candidateId}}"
            }
          },
          {
            "id": "generate",
            "typeId": "feature.kicktodo.nodes.plan-generate@1.0.0",
            "inputs": {
              "candidateId": "{{params.candidateId}}",
              "topic": "{{params.topic}}",
              "audience": "{{params.audience}}",
              "evidenceSummary": {
                "type": "variable",
                "variableName": "evidenceSummary"
              },
              "provider": "{{params.provider}}",
              "model": "{{params.model}}",
              "evidenceClaims": {
                "type": "variable",
                "variableName": "evidenceClaims"
              },
              "credentialRef": "{{params.credentialRef}}"
            }
          },
          {
            "id": "outline-approve",
            "typeId": "core.chat.approvalGate@1.1.0",
            "config": {
              "title": "Approve the challenge outline?",
              "artifactType": "challenge-outline",
              "maxRequestChangesIterations": 0,
              "actions": [
                "approve",
                "reject"
              ]
            },
            "inputs": {
              "artifact": {
                "type": "variable",
                "variableName": "plan"
              }
            }
          },
          {
            "id": "plan-validate",
            "typeId": "feature.kicktodo.nodes.plan-validate@1.0.0",
            "inputs": {
              "plan": {
                "type": "variable",
                "variableName": "plan"
              }
            }
          },
          {
            "id": "checkpoint-plan",
            "typeId": "feature.kicktodo.nodes.checkpoint-plan@1.0.0",
            "inputs": {
              "plan": {
                "type": "variable",
                "variableName": "plan"
              },
              "checkpointEvery": "{{params.checkpointEvery}}",
              "evidenceClaims": {
                "type": "variable",
                "variableName": "evidenceClaims"
              }
            }
          },
          {
            "id": "build-0",
            "typeId": "core.subWorkflow@1.0.0",
            "config": {
              "waitForCompletion": true,
              "onChildFailure": "fail-parent",
              "inputMapping": {
                "candidateId": "candidateId",
                "authorSubject": "authorSubject",
                "days": "batch0",
                "generateMedia": "generateMedia",
                "imageProvider": "imageProvider",
                "imageModel": "imageModel",
                "imageCredentialRef": "imageCredentialRef",
                "evidenceClaims": "evidenceClaims",
                "provider": "provider",
                "model": "model",
                "credentialRef": "credentialRef"
              },
              "subChainRef": "openwop-app.kicktodo.lesson-batch",
              "outputMapping": {
                "lessonBatch0": "lessonBatch"
              }
            }
          },
          {
            "id": "preview-0",
            "typeId": "feature.kicktodo.nodes.lesson-batch-preview@1.0.0",
            "inputs": {
              "lessonBatch": {
                "type": "variable",
                "variableName": "lessonBatch0"
              }
            }
          },
          {
            "id": "gate-0",
            "typeId": "core.chat.approvalGate@1.1.0",
            "config": {
              "title": "Approve the lessons for checkpoint 1?",
              "artifactType": "kicktodo.challenge-lesson-batch",
              "maxRequestChangesIterations": 0,
              "actions": [
                "approve",
                "reject"
              ]
            }
          },
          {
            "id": "fail-0",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_rejected",
              "message": "Checkpoint 1 was rejected — the factory run stops here."
            }
          },
          {
            "id": "build-fail-0",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_build_failed",
              "message": "Checkpoint 1's lessons could not be built or shown for approval — the factory run stops here rather than skip the checkpoint."
            }
          },
          {
            "id": "build-1",
            "typeId": "core.subWorkflow@1.0.0",
            "config": {
              "waitForCompletion": true,
              "onChildFailure": "fail-parent",
              "inputMapping": {
                "candidateId": "candidateId",
                "authorSubject": "authorSubject",
                "days": "batch1",
                "generateMedia": "generateMedia",
                "imageProvider": "imageProvider",
                "imageModel": "imageModel",
                "imageCredentialRef": "imageCredentialRef",
                "evidenceClaims": "evidenceClaims",
                "provider": "provider",
                "model": "model",
                "credentialRef": "credentialRef"
              },
              "subChainRef": "openwop-app.kicktodo.lesson-batch",
              "outputMapping": {
                "lessonBatch1": "lessonBatch"
              }
            }
          },
          {
            "id": "preview-1",
            "typeId": "feature.kicktodo.nodes.lesson-batch-preview@1.0.0",
            "inputs": {
              "lessonBatch": {
                "type": "variable",
                "variableName": "lessonBatch1"
              }
            }
          },
          {
            "id": "gate-1",
            "typeId": "core.chat.approvalGate@1.1.0",
            "config": {
              "title": "Approve the lessons for checkpoint 2?",
              "artifactType": "kicktodo.challenge-lesson-batch",
              "maxRequestChangesIterations": 0,
              "actions": [
                "approve",
                "reject"
              ]
            }
          },
          {
            "id": "fail-1",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_rejected",
              "message": "Checkpoint 2 was rejected — the factory run stops here."
            }
          },
          {
            "id": "build-fail-1",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_build_failed",
              "message": "Checkpoint 2's lessons could not be built or shown for approval — the factory run stops here rather than skip the checkpoint."
            }
          },
          {
            "id": "build-2",
            "typeId": "core.subWorkflow@1.0.0",
            "config": {
              "waitForCompletion": true,
              "onChildFailure": "fail-parent",
              "inputMapping": {
                "candidateId": "candidateId",
                "authorSubject": "authorSubject",
                "days": "batch2",
                "generateMedia": "generateMedia",
                "imageProvider": "imageProvider",
                "imageModel": "imageModel",
                "imageCredentialRef": "imageCredentialRef",
                "evidenceClaims": "evidenceClaims",
                "provider": "provider",
                "model": "model",
                "credentialRef": "credentialRef"
              },
              "subChainRef": "openwop-app.kicktodo.lesson-batch",
              "outputMapping": {
                "lessonBatch2": "lessonBatch"
              }
            }
          },
          {
            "id": "preview-2",
            "typeId": "feature.kicktodo.nodes.lesson-batch-preview@1.0.0",
            "inputs": {
              "lessonBatch": {
                "type": "variable",
                "variableName": "lessonBatch2"
              }
            }
          },
          {
            "id": "gate-2",
            "typeId": "core.chat.approvalGate@1.1.0",
            "config": {
              "title": "Approve the lessons for checkpoint 3?",
              "artifactType": "kicktodo.challenge-lesson-batch",
              "maxRequestChangesIterations": 0,
              "actions": [
                "approve",
                "reject"
              ]
            }
          },
          {
            "id": "fail-2",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_rejected",
              "message": "Checkpoint 3 was rejected — the factory run stops here."
            }
          },
          {
            "id": "build-fail-2",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_build_failed",
              "message": "Checkpoint 3's lessons could not be built or shown for approval — the factory run stops here rather than skip the checkpoint."
            }
          },
          {
            "id": "build-3",
            "typeId": "core.subWorkflow@1.0.0",
            "config": {
              "waitForCompletion": true,
              "onChildFailure": "fail-parent",
              "inputMapping": {
                "candidateId": "candidateId",
                "authorSubject": "authorSubject",
                "days": "batch3",
                "generateMedia": "generateMedia",
                "imageProvider": "imageProvider",
                "imageModel": "imageModel",
                "imageCredentialRef": "imageCredentialRef",
                "evidenceClaims": "evidenceClaims",
                "provider": "provider",
                "model": "model",
                "credentialRef": "credentialRef"
              },
              "subChainRef": "openwop-app.kicktodo.lesson-batch",
              "outputMapping": {
                "lessonBatch3": "lessonBatch"
              }
            }
          },
          {
            "id": "preview-3",
            "typeId": "feature.kicktodo.nodes.lesson-batch-preview@1.0.0",
            "inputs": {
              "lessonBatch": {
                "type": "variable",
                "variableName": "lessonBatch3"
              }
            }
          },
          {
            "id": "gate-3",
            "typeId": "core.chat.approvalGate@1.1.0",
            "config": {
              "title": "Approve the lessons for checkpoint 4?",
              "artifactType": "kicktodo.challenge-lesson-batch",
              "maxRequestChangesIterations": 0,
              "actions": [
                "approve",
                "reject"
              ]
            }
          },
          {
            "id": "fail-3",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_rejected",
              "message": "Checkpoint 4 was rejected — the factory run stops here."
            }
          },
          {
            "id": "build-fail-3",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "checkpoint_build_failed",
              "message": "Checkpoint 4's lessons could not be built or shown for approval — the factory run stops here rather than skip the checkpoint."
            }
          },
          {
            "id": "decompose",
            "typeId": "feature.kicktodo.nodes.decompose@1.0.0",
            "inputs": {
              "plan": {
                "type": "variable",
                "variableName": "plan"
              },
              "authorSubject": "{{params.authorSubject}}",
              "candidateId": "{{params.candidateId}}"
            }
          },
          {
            "id": "sim-newcomer",
            "typeId": "local.openwop-app.agent-runner@1.0.0",
            "config": {
              "offerTools": []
            },
            "inputs": {
              "agentId": "vendor.openwop-app.kicktodo.agents.sim-newcomer",
              "task": {
                "type": "variable",
                "variableName": "planBrief"
              },
              "provider": "{{params.provider}}",
              "model": "{{params.model}}",
              "credentialRef": "{{params.credentialRef}}"
            }
          },
          {
            "id": "sim-time-poor",
            "typeId": "local.openwop-app.agent-runner@1.0.0",
            "config": {
              "offerTools": []
            },
            "inputs": {
              "agentId": "vendor.openwop-app.kicktodo.agents.sim-time-poor",
              "task": {
                "type": "variable",
                "variableName": "planBrief"
              },
              "provider": "{{params.provider}}",
              "model": "{{params.model}}",
              "credentialRef": "{{params.credentialRef}}"
            }
          },
          {
            "id": "sim-skeptic",
            "typeId": "local.openwop-app.agent-runner@1.0.0",
            "config": {
              "offerTools": []
            },
            "inputs": {
              "agentId": "vendor.openwop-app.kicktodo.agents.sim-skeptic",
              "task": {
                "type": "variable",
                "variableName": "planEvidenceBrief"
              },
              "provider": "{{params.provider}}",
              "model": "{{params.model}}",
              "credentialRef": "{{params.credentialRef}}"
            }
          },
          {
            "id": "sim-collect",
            "typeId": "feature.kicktodo.nodes.sim-collect@1.0.0",
            "inputs": {
              "candidateId": "{{params.candidateId}}"
            }
          },
          {
            "id": "submit",
            "typeId": "feature.kicktodo.nodes.submit-publication@1.0.0",
            "inputs": {
              "candidateId": "{{params.candidateId}}"
            }
          },
          {
            "id": "gate-reject",
            "typeId": "core.fail@1.0.0",
            "config": {
              "code": "outline_rejected",
              "message": "The challenge outline was rejected — the factory run stops here."
            }
          }
        ],
        "edges": [
          {
            "from": "research-frame.searchQuery",
            "to": "search.query"
          },
          {
            "from": "search",
            "to": "normalize"
          },
          {
            "from": "evidence-graph",
            "to": "generate"
          },
          {
            "from": "generate",
            "to": "outline-approve"
          },
          {
            "from": "outline-approve",
            "to": "plan-validate",
            "triggerRule": "all_success",
            "condition": {
              "type": "truthy",
              "left": "approved"
            }
          },
          {
            "from": "plan-validate",
            "to": "checkpoint-plan",
            "triggerRule": "all_success"
          },
          {
            "from": "outline-approve",
            "to": "gate-reject",
            "condition": {
              "type": "falsy",
              "left": "approved"
            }
          },
          {
            "from": "checkpoint-plan",
            "to": "build-0",
            "triggerRule": "all_success",
            "condition": {
              "type": "truthy",
              "left": "slot0Live"
            }
          },
          {
            "from": "build-0",
            "to": "preview-0",
            "triggerRule": "all_success"
          },
          {
            "from": "preview-0",
            "to": "gate-0",
            "triggerRule": "all_success"
          },
          {
            "from": "gate-0",
            "to": "fail-0",
            "condition": {
              "type": "falsy",
              "left": "approved"
            }
          },
          {
            "from": "fail-0",
            "to": "decompose",
            "triggerRule": "none_failed"
          },
          {
            "from": "build-0",
            "to": "build-fail-0",
            "triggerRule": "any_failed"
          },
          {
            "from": "preview-0",
            "to": "build-fail-0",
            "triggerRule": "any_failed"
          },
          {
            "from": "build-fail-0",
            "to": "decompose",
            "triggerRule": "none_failed"
          },
          {
            "from": "checkpoint-plan",
            "to": "build-1",
            "triggerRule": "all_success",
            "condition": {
              "type": "truthy",
              "left": "slot1Live"
            }
          },
          {
            "from": "build-1",
            "to": "preview-1",
            "triggerRule": "all_success"
          },
          {
            "from": "preview-1",
            "to": "gate-1",
            "triggerRule": "all_success"
          },
          {
            "from": "gate-1",
            "to": "fail-1",
            "condition": {
              "type": "falsy",
              "left": "approved"
            }
          },
          {
