# Deploy topology for `scripts/deploy.sh` (ADR 0530).
#
# Copy to `scripts/deploy.env` and fill in YOUR values. That file is gitignored,
# so it never reaches `git archive HEAD` — which is how the white-label bundle is
# built (`scripts/build-whitelabel-zip.sh`). This is the same shape the repo
# already uses for `.env` / `.env.example`, and it is why `deploy.sh` carries no
# defaults: a script with our project baked in would ship our deploy topology to
# every adopter of the install bundle.
#
# `deploy.sh` refuses to run if any of these is unset. That is deliberate — a
# wrong-but-plausible default deploys someone's code to someone else's project,
# and an implicit distribution can build the wrong product surface. Use
# `default` explicitly for the full reference distribution, or the basename of
# a checked-in `distributions/<name>.json` manifest for a named distribution.

# Frontend distribution to build. Required; there is deliberately no fallback.
OPENWOP_DISTRIBUTION=

# Cloud Run service name.
OPENWOP_DEPLOY_SERVICE=

# GCP project id.
OPENWOP_DEPLOY_PROJECT=

# Cloud Run region.
OPENWOP_DEPLOY_REGION=us-central1

# The account with run.admin on the project. On the reference deployment this is
# NOT the project-owner account — check `gcloud run services list` → LAST DEPLOYED BY.
OPENWOP_DEPLOY_ACCOUNT=

# Firebase Hosting target for the SPA (`firebase deploy --only hosting:<target>`).
OPENWOP_DEPLOY_HOSTING_TARGET=app

# Firebase project id (usually the same as OPENWOP_DEPLOY_PROJECT).
OPENWOP_DEPLOY_FIREBASE_PROJECT=

# Public base URL, used by the preflight + verify steps to read the LIVE commit.
BASE=
# OPTIONAL — WHD-18 / ADR 0735. Where the signed POST-DEPLOY certification bundle
# lives: gs://<bucket>/<prefix>. Set it to the SAME value the service carries
# (`--update-env-vars OPENWOP_CERT_BUNDLE_ORIGIN=…`). Here it does two things:
# verify-deploy.sh checks the served bundle in "origin mode" (v3, this commit,
# the live signing key — PENDING until published, never a failure), and
# scripts/publish-evidence.sh uploads to it. Leave empty for image-mode evidence.
OPENWOP_CERT_BUNDLE_ORIGIN=
# The keyId (as published in OPENWOP_BUNDLE_SIGNING_KEYS) publish-evidence.sh signs under.
OPENWOP_BUNDLE_SIGNING_KEY_ID=
# Postgres max_connections of the instance behind OPENWOP_STORAGE_DSN (Cloud SQL db-f1-micro default 25).
# preflight-deploy.sh Gate 5 refuses a deploy whose pool × maxScale + tagged-idle × pool exceeds this − 3.
OPENWOP_PG_MAX_CONNECTIONS=25

# ADR 0745 D4 — NEVER put the conformance harness's OIDC env on a deployed service
# (OPENWOP_TEST_OIDC_ISSUER_URL, OPENWOP_TEST_OIDC_AUDIENCE, OPENWOP_CONFORMANCE_HARNESS_HOST,
# OPENWOP_CONFORMANCE_OIDC_PORT), nor an http/private OPENWOP_OIDC_ISSUER: the backend exits
# at boot on Cloud Run if you do. Harness-issuer rows are witnessed on a colocated
# release-image boot — docs/steward/CERTIFY-RUNBOOK.md § "Harness-issuer rows".
