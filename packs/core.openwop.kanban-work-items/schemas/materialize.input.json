{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.openwop.dev/core.openwop.kanban-work-items/1.1.0/materialize.input.json",
  "title": "KanbanWorkItemsMaterializeInput",
  "type": "object",
  "required": ["boardId", "proposal"],
  "properties": {
    "boardId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "approval": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["action"],
          "properties": { "action": { "type": "string" } },
          "additionalProperties": true
        }
      ],
      "description": "Optional canonical review-gate result; required only when configured."
    },
    "proposal": {
      "type": "object",
      "required": ["scope", "source", "items"],
      "properties": {
        "scope": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
            "externalRef": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
            "id": { "type": "string", "minLength": 1, "maxLength": 512 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["key", "title", "columnId"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 160 },
              "title": { "type": "string", "minLength": 1, "maxLength": 500 },
              "description": { "type": "string", "maxLength": 8000 },
              "columnId": { "type": "string", "minLength": 1, "maxLength": 160 },
              "workflowId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "dependsOnKeys": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "uniqueItems": true },
              "input": { "type": "object" },
              "priority": { "enum": ["low", "normal", "high"] },
              "dueAt": { "type": "string", "format": "date-time" },
              "execution": {
                "type": "object",
                "properties": {
                  "mode": { "enum": ["manual", "auto"] },
                  "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
