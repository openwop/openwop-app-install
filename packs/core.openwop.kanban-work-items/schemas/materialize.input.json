{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.openwop.dev/core.openwop.kanban-work-items/1.3.0/materialize.input.json",
  "title": "KanbanWorkItemsMaterializeInput",
  "type": "object",
  "required": ["boardId", "proposal"],
  "properties": {
    "boardId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "approval": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "required": ["action"],
          "properties": { "action": { "type": "string" } },
          "additionalProperties": true
        }
      ],
      "description": "Optional canonical review-gate result; required only when configured."
    },
    "proposal": {
      "type": "object",
      "required": ["scope", "source", "items"],
      "properties": {
        "scope": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
            "externalRef": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
            "id": { "type": "string", "minLength": 1, "maxLength": 512 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
          },
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["key", "title", "columnId"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 160 },
              "title": { "type": "string", "minLength": 1, "maxLength": 500 },
              "description": { "type": "string", "maxLength": 8000 },
              "columnId": { "type": "string", "minLength": 1, "maxLength": 160 },
              "workflowId": { "type": "string", "minLength": 1, "maxLength": 512 },
              "dependsOnKeys": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "uniqueItems": true },
              "input": { "type": "object" },
              "priority": { "enum": ["low", "normal", "high"] },
              "dueAt": { "type": "string", "format": "date-time" },
              "assigneeId": { "type": "string", "minLength": 1, "maxLength": 512, "description": "ADR 1137 D1: the one accountable person, set when the card is created. Must be a workspace member who can read the board's subject. Exclusive with assigneeRole." },
              "assigneeRole": { "type": "string", "minLength": 1, "maxLength": 128, "description": "ADR 1137 D1/D4: a claimable role. A workspace role key, or <kind>:<role> on that subject's board (project:lead, project:contributor)." },
              "assignmentReason": { "type": "string", "maxLength": 500 },
              "sourceLabel": { "type": "string", "maxLength": 200 },
              "labels": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
              "facets": {
                "type": "object",
                "maxProperties": 8,
                "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
                "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$" },
                "description": "ADR 1155 D1: stable grouping keys for the card (stage, room, system). At most 8 lower-case keys, each value 1-64 characters with no control characters. Written at create and rewritten by refresh, like the other source-owned facts."
              },
              "execution": {
                "type": "object",
                "properties": {
                  "mode": { "enum": ["manual", "auto"] },
                  "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
