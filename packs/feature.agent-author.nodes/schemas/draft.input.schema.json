{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.openwop.dev/feature.agent-author.nodes/1.1.0/draft.input.schema.json",
  "title": "Agent Author Draft Input",
  "type": "object",
  "required": ["intent"],
  "properties": {
    "intent": { "type": "string", "description": "The natural-language description of the agent to create." },
    "provider": { "type": "string", "description": "Optional LLM provider override (default: anthropic)." },
    "model": { "type": "string", "description": "Optional LLM model override (default: claude-sonnet-4-6)." },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Max draft→validate repair attempts (default 2)." }
  },
  "additionalProperties": false
}
