    {
      "taskId": "who-signs-off",
      "input": {
        "request": "Who has to approve a budget change on campaign camp-1?"
      },
      "expected": {
        "kind": "golden",
        "match": {
          "strategy": "contains",
          "value": "2 approvals"
        },
        "trajectory": {
          "match": "in-order",
          "calls": [
            {
              "tool": "openwop:campaign-orchestration.get-autonomy",
              "args": {
                "campaignId": "camp-1"
              },
              "argsMatch": "exact"
            }
          ],
          "forbidden": [
            "openwop:campaign-orchestration.run"
          ]
        }
      },
      "fixtures": {
        "onMiss": "fail",
        "toolResponses": [
          {
            "tool": "openwop:campaign-orchestration.get-autonomy",
            "args": {
              "campaignId": "camp-1"
            },
            "argsMatch": "exact",
            "response": {
              "autonomy": {
                "campaignId": "camp-1",
                "source": "client",
                "policy": {
                  "name": "Guarded",
                  "kind": "preset",
                  "preset": "guarded@1"
                },
                "steps": [
                  {
                    "step": "creative.generate",
                    "outcome": "auto"
                  },
                  {
                    "step": "plan.approve",
                    "outcome": "approve",
                    "approvers": {
                      "roles": [
                        "owner",
                        "admin"
                      ],
                      "required": 1
                    }
                  },
                  {
                    "step": "ads.launch",
                    "outcome": "approve",
                    "approvers": {
                      "roles": [
                        "owner",
                        "admin"
                      ],
                      "required": 1
                    }
                  },
                  {
                    "step": "ads.budget",
                    "outcome": "approve",
                    "approvers": {
                      "roles": [
                        "owner",
                        "admin"
                      ],
                      "required": 2
                    }
                  }
                ],
                "unknownFactsAsk": true,
                "alwaysApplies": [
                  "Nobody can approve their own request.",
                  "A step started by an outside agent (MCP) always needs a person to approve it."
                ]
              }
            }
          }
        ]
      }
    },
