{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.openwop.dev/core.openwop.ai/1.4.1/video-generate.output.json",
  "title": "AiVideoGenerateOutput",
  "type": "object",
  "required": ["video"],
  "properties": {
    "video": {
      "type": "object",
      "required": ["url", "mimeType", "durationSeconds", "width", "height", "safetyFiltered"],
      "properties": {
        "url": { "type": "string", "description": "Host-served video URL (videos are too large for inline base64)." },
        "mimeType": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "fileSizeBytes": { "type": "number" },
        "seed": { "type": "number" },
        "safetyFiltered": { "type": "boolean" },
        "metadata": { "type": "object" }
      }
    },
    "totalTimeMs": { "type": "number" },
    "usage": { "type": "object" }
  },
  "additionalProperties": true
}
