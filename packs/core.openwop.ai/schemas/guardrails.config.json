{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.openwop.dev/core.openwop.ai/1.4.1/guardrails.config.json",
  "title": "AiGuardrailsConfig",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pii",
          "toxicity",
          "topic",
          "prompt-injection"
        ]
      }
    },
    "requireEnforcement": {
      "type": "boolean",
      "description": "When true, fail (HOST_CAPABILITY_MISSING) instead of returning an unenforced pass-through on hosts without ctx.guardrails."
    }
  },
  "additionalProperties": false
}
