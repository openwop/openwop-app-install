{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.openwop.dev/core.openwop.ai/1.4.1/image-generate.output.json",
  "title": "AiImageGenerateOutput",
  "type": "object",
  "required": [
    "images"
  ],
  "properties": {
    "images": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "GenImg",
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Host-served asset URL for the generated image (media:/asset URL) — never raw base64 on the result boundary. Each image is persisted as a host Media asset (ADR 0007/0083)."
          },
          "mimeType": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "model": { "type": "string" },
              "provider": { "type": "string" },
              "seed": { "type": "integer" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "totalTimeMs": {
      "type": "integer"
    },
    "usage": {
      "type": "object",
      "properties": {
        "images": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
